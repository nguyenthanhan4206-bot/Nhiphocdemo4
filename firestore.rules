rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Reusable Primitives ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidLinkCode(code) {
      return code is string && code.size() >= 6 && code.size() <= 12 && code.matches('^[A-Z0-9]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isStr(val, min, max) {
      return val is string && val.size() >= min && val.size() <= max;
    }

    function isOptionalUid(val) {
      return val is string && val.size() <= 128 && (val == '' || val.matches('^[a-zA-Z0-9_\\-]+$'));
    }

    function isStudentDocMember(s) {
      return s.studentUid == request.auth.uid
        || s.parentUid == request.auth.uid
        || s.assistantUid == request.auth.uid
        || s.createdBy == request.auth.uid;
    }

    function hasMatchingStudentMembers(s, d) {
      return d.studentUid == s.studentUid
        && d.parentUid == s.parentUid
        && d.assistantUid == s.assistantUid;
    }

    function isResourceMember(d) {
      return d.studentUid == request.auth.uid
        || d.parentUid == request.auth.uid
        || d.assistantUid == request.auth.uid
        || d.createdBy == request.auth.uid;
    }

    function isMessageMember(d) {
      return d.studentUid == request.auth.uid
        || d.parentUid == request.auth.uid
        || d.assistantUid == request.auth.uid
        || d.senderUid == request.auth.uid;
    }

    // --- Validation Blueprints ---
    function isValidPublicUser(data) {
      return data.keys().hasAll(['uid', 'displayName', 'role', 'isOnline', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'role', 'isOnline', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && isStr(data.displayName, 1, 80)
        && data.role in ['student', 'parent', 'assistant']
        && data.isOnline is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPrivateUser(data) {
      return data.keys().hasAll(['uid', 'email', 'phone', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'phone', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && isStr(data.email, 0, 150)
        && isStr(data.phone, 0, 30)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidStudentProfile(data) {
      return data.keys().hasAll([
          'id', 'studentName', 'grade', 'linkCode',
          'studentUid', 'parentUid', 'assistantUid',
          'assistantOnline', 'focusMinutesTotal', 'treeLevel', 'streakDays',
          'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'studentName', 'grade', 'linkCode',
          'studentUid', 'parentUid', 'assistantUid',
          'assistantOnline', 'focusMinutesTotal', 'treeLevel', 'streakDays',
          'createdBy', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isStr(data.studentName, 1, 80)
        && isStr(data.grade, 1, 40)
        && isValidLinkCode(data.linkCode)
        && isOptionalUid(data.studentUid)
        && isOptionalUid(data.parentUid)
        && isOptionalUid(data.assistantUid)
        && data.assistantOnline is bool
        && data.focusMinutesTotal is number && data.focusMinutesTotal >= 0 && data.focusMinutesTotal <= 1000000
        && data.treeLevel is number && data.treeLevel >= 1 && data.treeLevel <= 10
        && data.streakDays is number && data.streakDays >= 0 && data.streakDays <= 10000
        && isValidId(data.createdBy)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidStudentInvite(data) {
      return data.keys().hasAll(['linkCode', 'studentId', 'studentName', 'grade', 'createdBy', 'createdAt'])
        && data.keys().hasOnly(['linkCode', 'studentId', 'studentName', 'grade', 'createdBy', 'createdAt'])
        && isValidLinkCode(data.linkCode)
        && isValidId(data.studentId)
        && isStr(data.studentName, 1, 80)
        && isStr(data.grade, 1, 40)
        && isValidId(data.createdBy)
        && data.createdAt is timestamp;
    }

    function isValidAssignment(data) {
      return data.keys().hasAll([
          'id', 'studentId', 'studentUid', 'parentUid', 'assistantUid', 'createdBy',
          'type', 'subject', 'title', 'description', 'dueLabel', 'status',
          'photoDataUrl', 'studentNote', 'submittedAtMs', 'feedbackScheduledAtMs',
          'instantFeedbackNote', 'assistantFeedback', 'scoreLabel', 'gradedBy',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'studentId', 'studentUid', 'parentUid', 'assistantUid', 'createdBy',
          'type', 'subject', 'title', 'description', 'dueLabel', 'status',
          'photoDataUrl', 'studentNote', 'submittedAtMs', 'feedbackScheduledAtMs',
          'instantFeedbackNote', 'assistantFeedback', 'scoreLabel', 'gradedBy',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.studentId)
        && isOptionalUid(data.studentUid)
        && isOptionalUid(data.parentUid)
        && isOptionalUid(data.assistantUid)
        && isValidId(data.createdBy)
        && data.type in ['today', 'extra']
        && isStr(data.subject, 1, 40)
        && isStr(data.title, 1, 120)
        && isStr(data.description, 0, 800)
        && isStr(data.dueLabel, 0, 60)
        && data.status in ['pending', 'submitted', 'graded']
        && isStr(data.photoDataUrl, 0, 260000)
        && isStr(data.studentNote, 0, 500)
        && data.submittedAtMs is number && data.submittedAtMs >= 0
        && data.feedbackScheduledAtMs is number && data.feedbackScheduledAtMs >= 0
        && isStr(data.instantFeedbackNote, 0, 300)
        && isStr(data.assistantFeedback, 0, 1000)
        && isStr(data.scoreLabel, 0, 40)
        && isOptionalUid(data.gradedBy)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidFocusSession(data) {
      return data.keys().hasAll([
          'id', 'studentId', 'studentUid', 'parentUid', 'assistantUid',
          'durationMinutes', 'treeStage', 'note', 'createdBy', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'studentId', 'studentUid', 'parentUid', 'assistantUid',
          'durationMinutes', 'treeStage', 'note', 'createdBy', 'createdAt'
        ])
        && isValidId(data.id)
        && isValidId(data.studentId)
        && isOptionalUid(data.studentUid)
        && isOptionalUid(data.parentUid)
        && isOptionalUid(data.assistantUid)
        && data.durationMinutes is number && data.durationMinutes >= 1 && data.durationMinutes <= 180
        && isStr(data.treeStage, 1, 40)
        && isStr(data.note, 0, 200)
        && isValidId(data.createdBy)
        && data.createdAt is timestamp;
    }

    function isValidMessage(data) {
      return data.keys().hasAll([
          'id', 'studentId', 'studentUid', 'parentUid', 'assistantUid',
          'senderUid', 'senderName', 'senderRole', 'content', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'studentId', 'studentUid', 'parentUid', 'assistantUid',
          'senderUid', 'senderName', 'senderRole', 'content', 'createdAt'
        ])
        && isValidId(data.id)
        && isValidId(data.studentId)
        && isOptionalUid(data.studentUid)
        && isOptionalUid(data.parentUid)
        && isOptionalUid(data.assistantUid)
        && isValidId(data.senderUid)
        && isStr(data.senderName, 1, 80)
        && data.senderRole in ['student', 'parent', 'assistant']
        && isStr(data.content, 1, 1000)
        && data.createdAt is timestamp;
    }

    function isValidSchedule(data) {
      return data.keys().hasAll([
          'id', 'studentId', 'studentUid', 'parentUid', 'assistantUid',
          'createdBy', 'title', 'dateStr', 'timeStr', 'note', 'status',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'studentId', 'studentUid', 'parentUid', 'assistantUid',
          'createdBy', 'title', 'dateStr', 'timeStr', 'note', 'status',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.studentId)
        && isOptionalUid(data.studentUid)
        && isOptionalUid(data.parentUid)
        && isOptionalUid(data.assistantUid)
        && isValidId(data.createdBy)
        && isStr(data.title, 1, 120)
        && isStr(data.dateStr, 1, 20)
        && isStr(data.timeStr, 1, 20)
        && isStr(data.note, 0, 400)
        && data.status in ['requested', 'confirmed', 'completed', 'cancelled']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidFeedbackTicket(data) {
      return data.keys().hasAll([
          'id', 'studentId', 'studentUid', 'parentUid', 'assistantUid',
          'createdBy', 'category', 'subject', 'message', 'reply',
          'repliedBy', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'studentId', 'studentUid', 'parentUid', 'assistantUid',
          'createdBy', 'category', 'subject', 'message', 'reply',
          'repliedBy', 'status', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.studentId)
        && isOptionalUid(data.studentUid)
        && isOptionalUid(data.parentUid)
        && isOptionalUid(data.assistantUid)
        && isValidId(data.createdBy)
        && data.category in ['feedback', 'support', 'management']
        && isStr(data.subject, 1, 120)
        && isStr(data.message, 1, 1000)
        && isStr(data.reply, 0, 1000)
        && isOptionalUid(data.repliedBy)
        && data.status in ['open', 'replied', 'closed']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // --- Collection Rules ---

    match /users_public/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if false;
      allow create: if isVerifiedUser()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidPublicUser(incoming())
        && incoming().uid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidPublicUser(incoming())
        && incoming().uid == existing().uid
        && incoming().role == existing().role
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'isOnline', 'updatedAt']);
      allow delete: if isVerifiedUser() && isValidId(userId) && request.auth.uid == userId;
    }

    match /users_private/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if false;
      allow create: if isVerifiedUser()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidPrivateUser(incoming())
        && incoming().uid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidPrivateUser(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'phone', 'updatedAt']);
      allow delete: if isVerifiedUser() && isValidId(userId) && request.auth.uid == userId;
    }

    match /student_invites/{linkCode} {
      allow get: if isSignedIn() && isValidLinkCode(linkCode);
      allow list: if false;
      allow create: if isVerifiedUser()
        && isValidLinkCode(linkCode)
        && isValidStudentInvite(incoming())
        && incoming().linkCode == linkCode
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && existsAfter(/databases/$(database)/documents/students/$(incoming().studentId));
      allow update: if false;
      allow delete: if isVerifiedUser()
        && isValidLinkCode(linkCode)
        && existing().createdBy == request.auth.uid;
    }

    match /students/{studentId} {
      allow get: if isSignedIn() && isValidId(studentId) && isResourceMember(existing());
      allow list: if isSignedIn() && (
        resource.data.studentUid == request.auth.uid
        || resource.data.parentUid == request.auth.uid
        || resource.data.assistantUid == request.auth.uid
        || resource.data.createdBy == request.auth.uid
      );
      allow create: if isVerifiedUser()
        && isValidId(studentId)
        && isValidStudentProfile(incoming())
        && incoming().id == studentId
        && incoming().createdBy == request.auth.uid
        && (
          incoming().studentUid == request.auth.uid
          || incoming().parentUid == request.auth.uid
          || incoming().assistantUid == request.auth.uid
        )
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(studentId)
        && isValidStudentProfile(incoming())
        && incoming().id == existing().id
        && incoming().linkCode == existing().linkCode
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action: Claim Student Slot
          (existing().studentUid == ''
            && incoming().studentUid == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['studentUid', 'updatedAt']))
          ||
          // Action: Link Parent
          (existing().parentUid == ''
            && incoming().parentUid == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['parentUid', 'updatedAt']))
          ||
          // Action: Link Assistant
          (existing().assistantUid == ''
            && incoming().assistantUid == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['assistantUid', 'assistantOnline', 'updatedAt']))
          ||
          // Action: Update Focus Tree progress
          ((existing().studentUid == request.auth.uid || existing().createdBy == request.auth.uid)
            && incoming().diff(existing()).affectedKeys().hasOnly(['focusMinutesTotal', 'treeLevel', 'streakDays', 'updatedAt']))
          ||
          // Action: Update Assistant Online Presence
          (existing().assistantUid == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['assistantOnline', 'updatedAt']))
          ||
          // Action: Update Student Metadata
          (isResourceMember(existing())
            && incoming().diff(existing()).affectedKeys().hasOnly(['studentName', 'grade', 'updatedAt']))
          ||
          // Action: Unlink self on account deletion
          (existing().studentUid == request.auth.uid
            && incoming().studentUid == ''
            && incoming().diff(existing()).affectedKeys().hasOnly(['studentUid', 'updatedAt']))
          ||
          (existing().parentUid == request.auth.uid
            && incoming().parentUid == ''
            && incoming().diff(existing()).affectedKeys().hasOnly(['parentUid', 'updatedAt']))
          ||
          (existing().assistantUid == request.auth.uid
            && incoming().assistantUid == ''
            && incoming().assistantOnline == false
            && incoming().diff(existing()).affectedKeys().hasOnly(['assistantUid', 'assistantOnline', 'updatedAt']))
        );
      allow delete: if isVerifiedUser()
        && isValidId(studentId)
        && existing().createdBy == request.auth.uid
        && (existing().studentUid == '' || existing().studentUid == request.auth.uid)
        && (existing().parentUid == '' || existing().parentUid == request.auth.uid)
        && (existing().assistantUid == '' || existing().assistantUid == request.auth.uid);
    }

    match /assignments/{assignmentId} {
      allow get: if isSignedIn() && isValidId(assignmentId) && isResourceMember(existing());
      allow list: if isSignedIn() && (
        resource.data.studentUid == request.auth.uid
        || resource.data.parentUid == request.auth.uid
        || resource.data.assistantUid == request.auth.uid
        || resource.data.createdBy == request.auth.uid
      );
      allow create: if isVerifiedUser()
        && isValidId(assignmentId)
        && isValidAssignment(incoming())
        && incoming().id == assignmentId
        && incoming().createdBy == request.auth.uid
        && incoming().status == 'pending'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/students/$(incoming().studentId))
        && isStudentDocMember(getAfter(/databases/$(database)/documents/students/$(incoming().studentId)).data)
        && hasMatchingStudentMembers(getAfter(/databases/$(database)/documents/students/$(incoming().studentId)).data, incoming());
      allow update: if isVerifiedUser()
        && isValidId(assignmentId)
        && isValidAssignment(incoming())
        && incoming().id == existing().id
        && incoming().studentId == existing().studentId
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action: Sync linked member UIDs from parent student doc
          (isStudentDocMember(get(/databases/$(database)/documents/students/$(existing().studentId)).data)
            && hasMatchingStudentMembers(get(/databases/$(database)/documents/students/$(existing().studentId)).data, incoming())
            && incoming().diff(existing()).affectedKeys().hasOnly(['studentUid', 'parentUid', 'assistantUid', 'updatedAt']))
          ||
          // Terminal state gate for content mutations
          (existing().status != 'graded' && (
            // Action: Student submits or updates photo homework before grading
            ((existing().studentUid == request.auth.uid || existing().createdBy == request.auth.uid)
              && existing().status in ['pending', 'submitted']
              && incoming().status == 'submitted'
              && incoming().diff(existing()).affectedKeys().hasOnly([
                'status', 'photoDataUrl', 'studentNote',
                'submittedAtMs', 'feedbackScheduledAtMs', 'instantFeedbackNote', 'updatedAt'
              ]))
            ||
            // Action: Assistant grades homework
            ((existing().assistantUid == request.auth.uid || existing().createdBy == request.auth.uid)
              && incoming().status == 'graded'
              && incoming().gradedBy == request.auth.uid
              && incoming().diff(existing()).affectedKeys().hasOnly([
                'status', 'assistantFeedback', 'scoreLabel', 'gradedBy', 'updatedAt'
              ]))
            ||
            // Action: Edit pending assignment details
            ((existing().assistantUid == request.auth.uid || existing().createdBy == request.auth.uid)
              && existing().status == 'pending'
              && incoming().diff(existing()).affectedKeys().hasOnly([
                'title', 'description', 'dueLabel', 'subject', 'updatedAt'
              ]))
          ))
        );
      allow delete: if isVerifiedUser()
        && isValidId(assignmentId)
        && (
          ((existing().assistantUid == request.auth.uid || existing().createdBy == request.auth.uid)
            && existing().status == 'pending')
          ||
          (existing().createdBy == request.auth.uid
            && (existing().studentUid == '' || existing().studentUid == request.auth.uid)
            && (existing().parentUid == '' || existing().parentUid == request.auth.uid)
            && (existing().assistantUid == '' || existing().assistantUid == request.auth.uid))
        );
    }

    match /focus_sessions/{sessionId} {
      allow get: if isSignedIn() && isValidId(sessionId) && isResourceMember(existing());
      allow list: if isSignedIn() && (
        resource.data.studentUid == request.auth.uid
        || resource.data.parentUid == request.auth.uid
        || resource.data.assistantUid == request.auth.uid
        || resource.data.createdBy == request.auth.uid
      );
      allow create: if isVerifiedUser()
        && isValidId(sessionId)
        && isValidFocusSession(incoming())
        && incoming().id == sessionId
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && exists(/databases/$(database)/documents/students/$(incoming().studentId))
        && isStudentDocMember(get(/databases/$(database)/documents/students/$(incoming().studentId)).data)
        && hasMatchingStudentMembers(get(/databases/$(database)/documents/students/$(incoming().studentId)).data, incoming());
      allow update: if isVerifiedUser()
        && isValidId(sessionId)
        && isValidFocusSession(incoming())
        && incoming().id == existing().id
        && incoming().studentId == existing().studentId
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && isStudentDocMember(get(/databases/$(database)/documents/students/$(existing().studentId)).data)
        && hasMatchingStudentMembers(get(/databases/$(database)/documents/students/$(existing().studentId)).data, incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['studentUid', 'parentUid', 'assistantUid']);
      allow delete: if isVerifiedUser()
        && isValidId(sessionId)
        && existing().createdBy == request.auth.uid
        && (existing().studentUid == '' || existing().studentUid == request.auth.uid)
        && (existing().parentUid == '' || existing().parentUid == request.auth.uid)
        && (existing().assistantUid == '' || existing().assistantUid == request.auth.uid);
    }

    match /messages/{messageId} {
      allow get: if isSignedIn() && isValidId(messageId) && isMessageMember(existing());
      allow list: if isSignedIn() && (
        resource.data.studentUid == request.auth.uid
        || resource.data.parentUid == request.auth.uid
        || resource.data.assistantUid == request.auth.uid
        || resource.data.senderUid == request.auth.uid
      );
      allow create: if isVerifiedUser()
        && isValidId(messageId)
        && isValidMessage(incoming())
        && incoming().id == messageId
        && incoming().senderUid == request.auth.uid
        && incoming().createdAt == request.time
        && exists(/databases/$(database)/documents/students/$(incoming().studentId))
        && isStudentDocMember(get(/databases/$(database)/documents/students/$(incoming().studentId)).data)
        && hasMatchingStudentMembers(get(/databases/$(database)/documents/students/$(incoming().studentId)).data, incoming());
      allow update: if isVerifiedUser()
        && isValidId(messageId)
        && isValidMessage(incoming())
        && incoming().id == existing().id
        && incoming().studentId == existing().studentId
        && incoming().senderUid == existing().senderUid
        && incoming().createdAt == existing().createdAt
        && isStudentDocMember(get(/databases/$(database)/documents/students/$(existing().studentId)).data)
        && hasMatchingStudentMembers(get(/databases/$(database)/documents/students/$(existing().studentId)).data, incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['studentUid', 'parentUid', 'assistantUid']);
      allow delete: if isVerifiedUser()
        && isValidId(messageId)
        && existing().senderUid == request.auth.uid
        && (existing().studentUid == '' || existing().studentUid == request.auth.uid)
        && (existing().parentUid == '' || existing().parentUid == request.auth.uid)
        && (existing().assistantUid == '' || existing().assistantUid == request.auth.uid);
    }

    match /schedules/{scheduleId} {
      allow get: if isSignedIn() && isValidId(scheduleId) && isResourceMember(existing());
      allow list: if isSignedIn() && (
        resource.data.studentUid == request.auth.uid
        || resource.data.parentUid == request.auth.uid
        || resource.data.assistantUid == request.auth.uid
        || resource.data.createdBy == request.auth.uid
      );
      allow create: if isVerifiedUser()
        && isValidId(scheduleId)
        && isValidSchedule(incoming())
        && incoming().id == scheduleId
        && incoming().createdBy == request.auth.uid
        && incoming().status == 'requested'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/students/$(incoming().studentId))
        && isStudentDocMember(get(/databases/$(database)/documents/students/$(incoming().studentId)).data)
        && hasMatchingStudentMembers(get(/databases/$(database)/documents/students/$(incoming().studentId)).data, incoming());
      allow update: if isVerifiedUser()
        && isValidId(scheduleId)
        && isValidSchedule(incoming())
        && incoming().id == existing().id
        && incoming().studentId == existing().studentId
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (isStudentDocMember(get(/databases/$(database)/documents/students/$(existing().studentId)).data)
            && hasMatchingStudentMembers(get(/databases/$(database)/documents/students/$(existing().studentId)).data, incoming())
            && incoming().diff(existing()).affectedKeys().hasOnly(['studentUid', 'parentUid', 'assistantUid', 'updatedAt']))
          ||
          (!(existing().status in ['completed', 'cancelled'])
            && isResourceMember(existing())
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'note', 'dateStr', 'timeStr', 'updatedAt']))
        );
      allow delete: if isVerifiedUser()
        && isValidId(scheduleId)
        && existing().createdBy == request.auth.uid
        && (existing().studentUid == '' || existing().studentUid == request.auth.uid)
        && (existing().parentUid == '' || existing().parentUid == request.auth.uid)
        && (existing().assistantUid == '' || existing().assistantUid == request.auth.uid);
    }

    match /feedback_tickets/{ticketId} {
      allow get: if isSignedIn() && isValidId(ticketId) && isResourceMember(existing());
      allow list: if isSignedIn() && (
        resource.data.studentUid == request.auth.uid
        || resource.data.parentUid == request.auth.uid
        || resource.data.assistantUid == request.auth.uid
        || resource.data.createdBy == request.auth.uid
      );
      allow create: if isVerifiedUser()
        && isValidId(ticketId)
        && isValidFeedbackTicket(incoming())
        && incoming().id == ticketId
        && incoming().createdBy == request.auth.uid
        && incoming().status == 'open'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/students/$(incoming().studentId))
        && isStudentDocMember(get(/databases/$(database)/documents/students/$(incoming().studentId)).data)
        && hasMatchingStudentMembers(get(/databases/$(database)/documents/students/$(incoming().studentId)).data, incoming());
      allow update: if isVerifiedUser()
        && isValidId(ticketId)
        && isValidFeedbackTicket(incoming())
        && incoming().id == existing().id
        && incoming().studentId == existing().studentId
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (isStudentDocMember(get(/databases/$(database)/documents/students/$(existing().studentId)).data)
            && hasMatchingStudentMembers(get(/databases/$(database)/documents/students/$(existing().studentId)).data, incoming())
            && incoming().diff(existing()).affectedKeys().hasOnly(['studentUid', 'parentUid', 'assistantUid', 'updatedAt']))
          ||
          (existing().status != 'closed'
            && isResourceMember(existing())
            && incoming().repliedBy == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['reply', 'repliedBy', 'status', 'updatedAt']))
          ||
          (existing().status != 'closed'
            && isResourceMember(existing())
            && incoming().status == 'closed'
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']))
        );
      allow delete: if isVerifiedUser()
        && isValidId(ticketId)
        && existing().createdBy == request.auth.uid
        && (existing().studentUid == '' || existing().studentUid == request.auth.uid)
        && (existing().parentUid == '' || existing().parentUid == request.auth.uid)
        && (existing().assistantUid == '' || existing().assistantUid == request.auth.uid);
    }
  }
}
