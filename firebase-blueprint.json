          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "linkCode": {
          "type": "string",
          "minLength": 6,
          "maxLength": 12,
          "pattern": "^[A-Z0-9]+$"
        },
        "studentUid": {
          "type": "string",
          "maxLength": 128
        },
        "parentUid": {
          "type": "string",
          "maxLength": 128
        },
        "assistantUid": {
          "type": "string",
          "maxLength": 128
        },
        "assistantOnline": {
          "type": "boolean"
        },
        "focusMinutesTotal": {
          "type": "number"
        },
        "treeLevel": {
          "type": "number"
        },
        "streakDays": {
          "type": "number"
        },
        "createdBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "studentName",
        "grade",
        "linkCode",
        "studentUid",
        "parentUid",
        "assistantUid",
        "assistantOnline",
        "focusMinutesTotal",
        "treeLevel",
        "streakDays",
        "createdBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "StudentInvite": {
      "title": "StudentInvite",
      "description": "Lookup index mapping a student linkCode to studentId without exposing PII.",
      "type": "object",
      "properties": {
        "linkCode": {
          "type": "string",
          "minLength": 6,
          "maxLength": 12,
          "pattern": "^[A-Z0-9]+$"
        },
        "studentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
