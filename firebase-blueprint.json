  "firestore": {
    "/users_public/{userId}": {
      "schema": { "$ref": "#/entities/PublicUser" },
      "description": "Public role and display profile for signed-in users."
    },
    "/users_private/{userId}": {
      "schema": { "$ref": "#/entities/PrivateUser" },
      "description": "Isolated PII contact fields accessible only by the owning user."
    },
    "/students/{studentId}": {
      "schema": { "$ref": "#/entities/StudentProfile" },
      "description": "Student learning profile linking student, parent, and assistant."
    },
    "/student_invites/{linkCode}": {
      "schema": { "$ref": "#/entities/StudentInvite" },
      "description": "Exact-lookup invite code mapping to studentId without PII."
    },
    "/assignments/{assignmentId}": {
      "schema": { "$ref": "#/entities/Assignment" },
      "description": "Student daily and supplemental homework assignments and graded feedback."
    },
    "/focus_sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/FocusSession" },
      "description": "Logged focus timer sessions for the student's Focus Tree."
    },
    "/messages/{messageId}": {
      "schema": { "$ref": "#/entities/Message" },
      "description": "Real-time communication messages for a student workspace."
    },
    "/schedules/{scheduleId}": {
      "schema": { "$ref": "#/entities/Schedule" },
      "description": "Scheduled sessions between parent, student, and assistant."
    },
    "/feedback_tickets/{ticketId}": {
      "schema": { "$ref": "#/entities/FeedbackTicket" },
      "description": "Parent feedback, help requests, and assistant management notes."
    }
  }
}
