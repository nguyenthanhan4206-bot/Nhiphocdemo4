          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["linkCode", "studentId", "studentName", "grade", "createdBy", "createdAt"]
    },
    "Assignment": {
      "title": "Assignment",
